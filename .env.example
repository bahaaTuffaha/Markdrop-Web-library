# Copy to .env next to docker-compose.yml if you want to change the build.

# full = Docling/Torch (normal convert). lite = PyMuPDF only, much smaller image.
MARKDROP_ENGINE=full

# Comma-separated extras from pyproject.toml. Core already includes Gemini + OpenAI.
MARKDROP_EXTRAS=lite,litellm

# Host port
MARKDROP_WEB_PORT=8080

# Container memory cap (not a reservation). Lite: 2g. Full/Docling: 8g.
# MARKDROP_MEM_LIMIT=2g
# MARKDROP_SHM_SIZE=64m

# Optional. If set, the UI asks for this password.
# MARKDROP_WEB_PASSWORD=
